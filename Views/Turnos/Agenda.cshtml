@{
    ViewData["Title"] = "Mi agenda";
    var secciones = new[]
    {
        (Accion: "Pendientes", Titulo: "Solicitudes pendientes", Texto: "Revisá y confirmá las nuevas solicitudes."),
        (Accion: "DelDia", Titulo: "Turnos del día", Texto: "Consultá los turnos confirmados y registrá la atención."),
        (Accion: "Historico", Titulo: "Histórico de turnos", Texto: "Buscá turnos por mascota, tutor o estado.")
    };
}
<div class="d-flex justify-content-between flex-wrap gap-2 mb-4">
    <h1 class="h2">Mi agenda</h1>
    <button class="btn btn-primary" data-form-url="@Url.Action("ObtenerFormulario")">Solicitar turno</button>
</div>
<nav aria-label="Secciones de la agenda" class="panel-atajos">
    @foreach (var seccion in secciones)
    {
        <a asp-action="@seccion.Accion" class="panel-atajo">
            <h2 class="mt-0">@seccion.Titulo</h2>
            <p class="mb-0">@seccion.Texto</p>
        </a>
    }
</nav>
<partial name="_CrudModal" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/crud.js" asp-append-version="true"></script>
}
