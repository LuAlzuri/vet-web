@model VetWeb.Dtos.CambiarPasswordDto
@{ ViewData["Title"] = "Cambiar contraseña"; }
<div class="d-flex justify-content-between flex-wrap gap-2 mb-4">
    <h1 class="h2">Cambiar contraseña</h1>
    <a asp-controller="Inicio" asp-action="Indice" class="btn btn-outline-secondary">Volver al inicio</a>
</div>
<div class="row"><div class="col-md-8 col-lg-6">
    <form asp-action="CambiarPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Actual" class="form-label"></label>
            <div class="input-group"><input asp-for="Actual" class="form-control" autocomplete="current-password" />
                <partial name="_MostrarPassword" model='@("Actual")' /></div>
            <span asp-validation-for="Actual" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Nueva" class="form-label"></label>
            <div class="input-group"><input asp-for="Nueva" class="form-control" autocomplete="new-password" />
                <partial name="_MostrarPassword" model='@("Nueva")' /></div>
            <span asp-validation-for="Nueva" class="text-danger"></span>
            <div class="form-text">Al menos 8 caracteres, mayúscula, minúscula, número y símbolo.</div>
        </div>
        <div class="mb-3">
            <label asp-for="Confirmacion" class="form-label"></label>
            <div class="input-group"><input asp-for="Confirmacion" class="form-control" autocomplete="new-password" />
                <partial name="_MostrarPassword" model='@("Confirmacion")' /></div>
            <span asp-validation-for="Confirmacion" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Guardar contraseña</button>
    </form>
</div></div>
@if (TempData["PasswordActualizada"] is not null)
{
    <span id="password-actualizada" hidden></span>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cuenta.js" asp-append-version="true"></script>
}
