@{ ViewData["Title"] = "Inicio"; ViewData["BodyClass"] = User.Identity?.IsAuthenticated == true ? "pagina-inicio" : "pagina-bienvenida"; }
@if (User.Identity?.IsAuthenticated != true)
{
    <section class="portada" aria-labelledby="titulo-portada">
        <div class="portada-contenido">
            <span class="etiqueta-seccion">EL REFUGIO · PELUQUERÍA CANINA</span>
            <h1 id="titulo-portada">Su bienestar,<br /><span>siempre cerca.</span></h1>
            <p>Turnos, cuidados y su historia en un mismo lugar. Con VeteWeb, acompañar a tu compañero es un poquito más simple.</p>
            <a class="btn btn-rosa btn-lg" asp-area="Identity" asp-page="/Account/Login">Ingresar a mi cuenta <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></a>
            <p class="portada-nota">La cuenta te la proporciona la veterinaria.</p>
        </div>
        <div class="portada-marca" aria-label="VeteWeb, el espacio de cuidado de El Refugio">
            <img src="~/images/brand/veteweb-logo.svg" alt="" width="140" height="140" />
            <span class="portada-nombre">VeteWeb</span>
            <span class="portada-subtitulo">Pequeños cuidados.<br />Grandes compañeros.</span>
            <span class="portada-sello"><partial name="_Icono" model='@("huella")' /> Hecho para cuidarlos</span>
        </div>
    </section>
    <section class="servicios-inicio" aria-labelledby="titulo-cuidados">
        <div class="seccion-cabecera"><span class="etiqueta-seccion">TODO A MANO</span><h2 id="titulo-cuidados">Más tiempo para estar juntos.</h2></div>
        <div class="panel-atajos">
            <article class="panel-atajo"><span class="atajo-icono"><partial name="_Icono" model='@("calendario")' /></span><h3>Su próximo turno</h3><p>Consultá la disponibilidad y organizá su próxima visita.</p></article>
            <article class="panel-atajo"><span class="atajo-icono atajo-rosa"><partial name="_Icono" model='@("huella")' /></span><h3>Su historia, cerquita</h3><p>Sus datos y atenciones, siempre a mano en tu cuenta.</p></article>
            <article class="panel-atajo"><span class="atajo-icono"><partial name="_Icono" model='@("servicios")' /></span><h3>El cuidado de siempre</h3><p>El equipo de la veterinaria, acompañándolos en cada paso.</p></article>
        </div>
    </section>
}
else
{
    <section class="inicio-panel" aria-labelledby="titulo-inicio">
        <div class="panel-bienvenida">
            <div><span class="etiqueta-seccion">TU ESPACIO EN VETEWEB</span><h1 id="titulo-inicio">Cada cuidado, en un solo lugar.</h1><p>Todo listo para una nueva visita a El Refugio.</p></div>
            <img class="panel-huella" src="~/images/brand/veteweb-logo.svg" width="76" height="76" alt="" />
        </div>
        @if (User.IsInRole(VetWeb.Services.RolSesion.Administrador))
        {
            <div class="seccion-cabecera"><h2>Administración</h2><p>Una mirada completa para acompañar al equipo.</p></div>
            <div class="panel-atajos">
                <a class="panel-atajo" asp-controller="Veterinarios" asp-action="Listado"><span class="atajo-icono"><partial name="_Icono" model='@("personas")' /></span><h3>Veterinarios</h3><p>Gestioná los profesionales del equipo.</p><span class="atajo-ir">Gestionar veterinarios <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></span></a>
                <a class="panel-atajo" asp-controller="Auditoria" asp-action="Listado"><span class="atajo-icono atajo-rosa"><partial name="_Icono" model='@("informe")' /></span><h3>Auditoría</h3><p>Consultá los movimientos y su historial.</p><span class="atajo-ir">Ver movimientos <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></span></a>
                <a class="panel-atajo" asp-controller="Informes" asp-action="Listado"><span class="atajo-icono"><partial name="_Icono" model='@("informe")' /></span><h3>Informes</h3><p>Explorá las solicitudes y las atenciones por período.</p><span class="atajo-ir">Consultar informes <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></span></a>
            </div>
        }
        @if (User.IsInRole("Veterinario"))
        {
            <div class="seccion-cabecera"><h2>Administración veterinaria</h2><p>Tu agenda y tus pacientes, más cerca.</p></div>
            <div class="panel-atajos">
                <a class="panel-atajo" asp-controller="Turnos" asp-action="Listado"><span class="atajo-icono"><partial name="_Icono" model='@("calendario")' /></span><h3>Mi agenda</h3><p>Organizá los turnos y registrá cada atención.</p><span class="atajo-ir">Ver agenda <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></span></a>
                <a class="panel-atajo" asp-controller="Perros" asp-action="Listado"><span class="atajo-icono atajo-rosa"><partial name="_Icono" model='@("huella")' /></span><h3>Perros</h3><p>Sus datos, cuidados e historia clínica.</p><span class="atajo-ir">Ver pacientes <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></span></a>
                <a class="panel-atajo" asp-controller="Tutores" asp-action="Listado"><span class="atajo-icono"><partial name="_Icono" model='@("personas")' /></span><h3>Tutores</h3><p>Gestioná sus cuentas, contactos y vetos.</p><span class="atajo-ir">Ver tutores <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></span></a>
                <a class="panel-atajo" asp-controller="CuposDiarios" asp-action="Listado"><span class="atajo-icono"><partial name="_Icono" model='@("calendario")' /></span><h3>Cupos disponibles</h3><p>Prepará la disponibilidad para las próximas visitas.</p><span class="atajo-ir">Administrar cupos <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></span></a>
                <a class="panel-atajo" asp-controller="Servicios" asp-action="Listado"><span class="atajo-icono atajo-rosa"><partial name="_Icono" model='@("servicios")' /></span><h3>Servicios</h3><p>Administrá las opciones de peluquería.</p><span class="atajo-ir">Ver servicios <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></span></a>
            </div>
        }
        @if (User.IsInRole("Tutor"))
        {
            <div class="seccion-cabecera"><h2>Mi espacio como tutor</h2><p>Un lugar para cuidar de quien siempre está con vos.</p></div>
            <div class="panel-atajos">
                <a class="panel-atajo" asp-controller="Perros" asp-action="MisPerros"><span class="atajo-icono atajo-rosa"><partial name="_Icono" model='@("huella")' /></span><h3>Mis perros</h3><p>Conocé sus datos y consultá su historial.</p><span class="atajo-ir">Ver mis perros <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></span></a>
                <a class="panel-atajo" asp-controller="Turnos" asp-action="MisTurnos"><span class="atajo-icono"><partial name="_Icono" model='@("calendario")' /></span><h3>Mis turnos</h3><p>Seguí tus solicitudes y próximas visitas.</p><span class="atajo-ir">Ver mis turnos <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></span></a>
                <a class="panel-atajo" asp-controller="CuposDiarios" asp-action="Disponibles"><span class="atajo-icono"><partial name="_Icono" model='@("calendario")' /></span><h3>Próxima visita</h3><p>Buscá un día disponible para su atención.</p><span class="atajo-ir">Consultar cupos <span aria-hidden="true"><partial name="_Icono" model='@("flecha")' /></span></span></a>
            </div>
        }
        <p class="panel-sesion">Estás trabajando con el rol indicado en el menú. Si tenés otro perfil, podés elegirlo desde tu nombre y <strong>Cambiar rol</strong>.</p>
    </section>
}
