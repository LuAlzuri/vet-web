<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VetWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Inicio" asp-action="Indice"><span class="marca-icono"><svg width="25" height="25" viewBox="0 0 48 48" fill="currentColor" aria-hidden="true" focusable="false"><ellipse cx="13" cy="13" rx="5" ry="7" transform="rotate(-20 13 13)" /><ellipse cx="24" cy="9" rx="5" ry="7" /><ellipse cx="35" cy="13" rx="5" ry="7" transform="rotate(20 35 13)" /><path d="M24 22c-6 0-8 5-12 9-3 3-3 9 2 11 4 2 7-1 10-1s6 3 10 1c5-2 5-8 2-11-4-4-6-9-12-9Z" /></svg></span>VetWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Mostrar u ocultar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Inicio" asp-action="Indice">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Inicio" asp-action="Privacidad">Privacidad</a>
                        </li>
                        <partial name="_MenuGestion" />
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container site-content">
        <main role="main" class="site-panel">
            @RenderBody()
        </main>
    </div>

    <footer class="footer site-footer">
        <div class="container">
            &copy; 2026 - VetWeb - <a asp-area="" asp-controller="Inicio" asp-action="Privacidad">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script src="~/js/alertas.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


