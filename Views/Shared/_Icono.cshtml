@model string
<svg class="icono" viewBox="@(Model == "huella" ? "6 7 28 26" : "0 0 24 24")" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
@switch (Model)
{
    case "catalogos":
        <rect x="3" y="3" width="7" height="7" rx="2" /><rect x="14" y="3" width="7" height="7" rx="2" />
        <rect x="3" y="14" width="7" height="7" rx="2" /><rect x="14" y="14" width="7" height="7" rx="2" />
        break;
    case "flecha":
        <path d="m7 17 10-10M7 7h10v10" />
        break;
    case "inicio":
        <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z" />
        break;
    case "calendario":
        <rect x="3" y="5" width="18" height="16" rx="3" /><path d="M7 3v4m10-4v4M3 11h18m-13 5 3 3 5-5" />
        break;
    case "personas":
        <circle cx="9" cy="8" r="3" /><path d="M3 21v-2a6 6 0 0 1 12 0v2m1-16a3 3 0 0 1 0 6m2 4a5 5 0 0 1 3 5" />
        break;
    case "informe":
        <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Zm0 0v6h6M8 16v2m4-5v5m4-3v3" />
        break;
    case "servicios":
        <circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="m8 8 12 12M8 16 20 4m-7 8-2-2" />
        break;
    default:
        <g fill="currentColor" stroke="none">
            <path d="M20 20c-2.8 0-4.5 2.3-6.7 4.3-1.8 1.7-2.5 3.6-1.5 5.3 1 1.8 3.2 2 5.3 1.2 1.1-.4 2-.7 2.9-.7s1.8.3 2.9.7c2.1.8 4.3.6 5.3-1.2 1-1.7.3-3.6-1.5-5.3C24.5 22.3 22.8 20 20 20Z" />
            <ellipse cx="10.7" cy="18.4" rx="2.8" ry="3.7" transform="rotate(-28 10.7 18.4)" />
            <ellipse cx="16.4" cy="12.7" rx="2.8" ry="3.8" transform="rotate(-12 16.4 12.7)" />
            <ellipse cx="23.6" cy="12.7" rx="2.8" ry="3.8" transform="rotate(12 23.6 12.7)" />
            <ellipse cx="29.3" cy="18.4" rx="2.8" ry="3.7" transform="rotate(28 29.3 18.4)" />
        </g>
        break;
}
</svg>
