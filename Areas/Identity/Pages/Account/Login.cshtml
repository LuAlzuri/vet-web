@page "/Identity/Cuenta/Ingresar"
@model VetWeb.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["BodyClass"] = "pagina-acceso";
}
<section class="acceso-escena" aria-labelledby="titulo-acceso">
    <div class="acceso-presentacion">
        <span class="etiqueta-seccion">EL REFUGIO · PELUQUERÍA CANINA</span>
        <h2>Un cuidado más cerca.<br />Una preocupación menos.</h2>
        <p>Sus turnos, su historia y todo lo que necesita para estar bien. Un espacio para acompañarte en cada cuidado.</p>
        <div class="acceso-nota"><partial name="_Icono" model='@("huella")' /><span>Con el cariño de siempre.<br /><strong>Ahora, también en la web.</strong></span></div>
    </div>
    <div class="acceso-panel">
        <h1 id="titulo-acceso" class="acceso-marca"><partial name="_Marca" /></h1>
        <p class="acceso-bajada">Ingresá a tu cuenta</p>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                    <partial name="_MostrarPassword" model='@("Input_Password")' />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-rosa w-100">Ingresar</button>
        </form>
        <p class="acceso-ayuda">¿Todavía no tenés cuenta?<br /><span>Solicitala en la veterinaria.</span></p>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
